{
  "name": "rep-log-backend",
  "version": "1.0.0",
  "description": "Express API for RepLog, a gym companion for logging workouts and reviewing training by muscle group.",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashwin-bhat-neu/rep-log.git"
  },
  "author": "Ashwin Bhat and Mohammed Sameer Sarfaraz Bake",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mongodb": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
